config speedcenter 'main'
	option engine 'ookla'
	option region 'cn'
	option cn_node 'auto'
	option server_source 'auto'
	option cn_server_list '/usr/share/speedcenter/servers-cn.example.json'
	option global_server_list '/usr/share/speedcenter/servers-global.example.json'
	option retention '30'
	option schedule 'off'
	option theme 'auto'
	option baseline_mbps '0'

config target
	option region 'cn'
	option name '百度'
	option host 'www.baidu.com'
	option ip ''
	option mode 'icmp'

config target
	option region 'cn'
	option name '腾讯 QQ'
	option host 'www.qq.com'
	option ip ''
	option mode 'icmp'

config target
	option region 'cn'
	option name '阿里云'
	option host 'www.aliyun.com'
	option ip ''
	option mode 'https'

