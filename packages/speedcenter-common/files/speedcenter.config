config speedcenter 'main'
	option engine 'ookla'
	option region 'cn'
	option server_source 'auto'
	option cn_server_list '/usr/share/speedcenter/servers-cn.example.json'
	option global_server_list '/usr/share/speedcenter/servers-global.example.json'
	option retention '30'
	option schedule 'off'
	option theme 'auto'
	option baseline_mbps '0'

config target
	option region 'cn'
	option name '百度'
	option host 'www.baidu.com'
	option ip ''
	option mode 'icmp'

config target
	option region 'cn'
	option name '腾讯'
	option host 'www.qq.com'
	option ip ''
	option mode 'icmp'

config target
	option region 'cn'
	option name 'B站'
	option host 'www.bilibili.com'
	option ip ''
	option mode 'icmp'

config target
	option region 'global'
	option name 'Google'
	option host 'www.google.com'
	option ip '142.250.196.68'
	option mode 'https'

config target
	option region 'global'
	option name 'GitHub'
	option host 'github.com'
	option ip '140.82.114.4'
	option mode 'https'

config target
	option region 'global'
	option name 'Cloudflare'
	option host 'www.cloudflare.com'
	option ip '104.16.132.229'
	option mode 'https'
